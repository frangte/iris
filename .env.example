# App (Expo). Leave empty in dev: the app talks to http://<máy chạy expo>:8787.
EXPO_PUBLIC_API_URL=

# Server (server/). Copy to server/.env or export before `bun src/index.ts`.
# PORT=8787
# DB_PATH=./data/floied.db
# RESEND_API_KEY=re_xxx            # có thì gửi OTP qua email thật; không có thì in mã ra console
# MAIL_FROM=Floied <otp@yourdomain.vn>
# OTP_DEV_ECHO=1                   # CHỈ dùng khi dev: trả mã OTP trong response (npm run server bật sẵn)
# NODE_ENV=production              # production: không bao giờ trả mã OTP, kể cả khi OTP_DEV_ECHO=1
